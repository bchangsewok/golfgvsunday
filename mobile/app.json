{
  "expo": {
    "name": "GolfGV",
    "slug": "golfgv",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "golfgv",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bchangsewok.golfgv",
      "infoPlist": {
        "NSCameraUsageDescription": "GolfGV uses the camera to scan round QR codes so you can join a Sunday round quickly."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.bchangsewok.golfgv",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-camera"],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/m"
    },
    "extra": {
      "apiBase": "https://app-golvgv-ctfqb6bzf7cshccx.australiacentral-01.azurewebsites.net"
    }
  }
}
